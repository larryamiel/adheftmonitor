# Same Supabase project as the QA runner. Server-side only (never exposed to the browser).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Password for the dashboard login. Use a long random one: this protects your service role key's powers.
DASHBOARD_PASSWORD=

# "Run QA now": a fine-grained GitHub token with Actions: Read and write on this repo only.
GITHUB_TOKEN=
GITHUB_REPO=your-user/adheftmonitor
# Branch the workflow lives on
GITHUB_REF=main
