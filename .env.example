# Supabase → Project Settings → API. The service role key bypasses RLS: keep it secret (GitHub Secrets / .env only).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Slack or Discord incoming webhook for alerts (new failures / fixes only)
ALERT_WEBHOOK_URL=

# Optional: Google PageSpeed Insights API key (free, 25k/day). Without it PSI is heavily rate-limited.
PSI_API_KEY=
